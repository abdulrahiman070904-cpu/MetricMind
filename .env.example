# Cube service connection (server only; do not use NEXT_PUBLIC_ prefixes)
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_API_TOKEN=replace-with-a-valid-cube-jwt

# Cube Docker / Snowflake connection
CUBEJS_API_SECRET=replace-with-a-long-random-secret
CUBEJS_DB_TYPE=snowflake
CUBEJS_DB_USER=
CUBEJS_DB_PASS=
CUBEJS_DB_NAME=METRICMIND_DB
CUBEJS_DB_SNOWFLAKE_ACCOUNT=
CUBEJS_DB_SNOWFLAKE_REGION=central-india.azure
CUBEJS_DB_SNOWFLAKE_SCHEMA=ANALYTICS
CUBEJS_DB_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
CUBEJS_DB_SNOWFLAKE_ROLE=
